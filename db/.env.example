# Copiar a .env y cambiar los valores. El archivo .env no se sube a git.
ORACLE_PASSWORD=cambiar_clave_sys
APP_USER=micomuna
APP_USER_PASSWORD=cambiar_clave_micomuna
ORACLE_PORT=1522
# Secreto para firmar los tokens JWT: al menos 32 caracteres, aleatorio y distinto en cada entorno.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio_de_mas_de_32_caracteres
# Opcional: correo de contacto que el backend manda a Nominatim (OpenStreetMap) al pedir direcciones,
# como recomienda su política de uso. Si queda vacío, se identifica solo con el nombre de la app.
NOMINATIM_CONTACTO=
# Superadmin de la plataforma: se crea al iniciar el backend solo si todavía no hay ninguno.
# Descomentar y poner un correo real y una clave de 8 a 72 caracteres. Cambiarlas después no modifica al que ya existe.
# SUPERADMIN_CORREO=superadmin@ejemplo.com
# SUPERADMIN_CLAVE=cambiar_por_una_clave_propia
# Dirección del frontend que se usa en los enlaces de los correos (invitaciones, recuperación de clave y avisos de
# reclamos). En producción tiene que ser la dirección real, con https, por ejemplo https://micomuna.ejemplo.gob.ar.
# Si no se define, los enlaces apuntan a http://localhost:4200 (no la dejes definida pero vacía).
# FRONTEND_URL=https://micomuna.ejemplo.gob.ar
# IA que sugiere tipo y prioridad de cada reclamo nuevo (la decisión siempre es del personal municipal).
# Proveedor: ninguno (por defecto) | claude | ollama. Con "ninguno" no se llama a nadie.
# MICOMUNA_IA_PROVEEDOR=ninguno
# Clave de la API de Anthropic, solo si el proveedor es claude. NUNCA la subas al repositorio ni la compartas:
# cada análisis cuesta plata. Si falta, el backend arranca igual y los reclamos quedan sin sugerencia.
# ANTHROPIC_API_KEY=
# Análisis de IA por día y por comuna (superado el tope, los reclamos quedan sin sugerencia).
# MICOMUNA_IA_TOPE_DIARIO=200
# Tope global por día (todas las comunas juntas). Los dos topes son APROXIMADOS: con dos hilos analizando a la vez pueden
# pasarse en uno o dos análisis. El control real del gasto es el límite de gasto que se configura en la consola de Anthropic.
# MICOMUNA_IA_TOPE_DIARIO_TOTAL=1000
# Solo para pruebas con un servidor simulado: URL alternativa de Claude. NO se define en producción. Si se define tiene que
# ser https, o el backend no arranca.
# MICOMUNA_IA_CLAUDE_URL=
# Ollama (modelo local), solo si el proveedor es ollama. Sin definir: http://localhost:11434 y qwen3-vl.
# No las dejes definidas pero vacías.
# La URL de Ollama tiene que ser https, salvo localhost, 127.0.0.1, ::1 o una dirección privada (10.x, 172.16-31.x,
# 192.168.x); si no, el backend no arranca.
# OLLAMA_URL=
# OLLAMA_MODELO=
