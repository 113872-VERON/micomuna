# Copiar a .env y cambiar los valores. El archivo .env no se sube a git.
ORACLE_PASSWORD=cambiar_clave_sys
APP_USER=micomuna
APP_USER_PASSWORD=cambiar_clave_micomuna
ORACLE_PORT=1522
# Secreto para firmar los tokens JWT: al menos 32 caracteres, aleatorio y distinto en cada entorno.
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio_de_mas_de_32_caracteres
# Opcional: correo de contacto que el backend manda a Nominatim (OpenStreetMap) al pedir direcciones,
# como recomienda su política de uso. Si queda vacío, se identifica solo con el nombre de la app.
NOMINATIM_CONTACTO=
# Superadmin de la plataforma: se crea al iniciar el backend solo si todavía no hay ninguno.
# Descomentar y poner un correo real y una clave de 8 a 72 caracteres. Cambiarlas después no modifica al que ya existe.
# SUPERADMIN_CORREO=superadmin@ejemplo.com
# SUPERADMIN_CLAVE=cambiar_por_una_clave_propia
